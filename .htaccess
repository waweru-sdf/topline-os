# ONLY for "Option B" in SETUP-HOSTINGER.md (the whole Topline folder uploaded inside public_html).
# Rename this file to .htaccess and put it directly in public_html.
# It sends every request into the public/ folder, so the code, .env and storage are never reachable.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
