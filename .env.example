# Development settings for the frontend. Copy to .env.
# (Production builds use .env.production; the server writes .env.production.local.)

# Root domain that shop subdomains hang off (mjengo.toplinehub.co.ke).
# In development, stores also work at /s/<slug> and at <slug>.localhost:5173.
VITE_ROOT_DOMAIN=toplinehub.co.ke

# Where the Flask API is. The backend must be running.
VITE_API_URL=http://localhost:5000/api
