# Development settings for the website (npm run dev). Copy to .env.
# Production builds use .env.production (npm run build:laravel sets the same values).

VITE_ROOT_DOMAIN=toplinehub.co.ke
VITE_STORE_LINKS=path

# Where the Laravel API is: run `php artisan serve` in laravel/ first.
VITE_API_URL=http://localhost:8000/api
