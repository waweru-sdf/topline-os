# Topline settings. On Hostinger: copy this file to .env (next to artisan) and fill it in.
# Never put this file's filled-in copy (.env) on GitHub or in a chat.

APP_NAME=Topline
APP_ENV=production
# Filled in automatically by the Cron Job on the first run
APP_KEY=
APP_DEBUG=false
APP_URL=https://toplinehub.co.ke
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

# hPanel → Databases → MySQL Databases (the names start with u123456789_)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_topline
DB_USERNAME=u123456789_topline
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Your first admin login ------------------------------------------------
# The Cron Job creates this admin once, when the site has no admin yet.
# After you've logged in, delete the password line below (leave it empty).
FIRST_ADMIN_NAME="Felix Waweru"
FIRST_ADMIN_PHONE=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Topline ---------------------------------------------------------------
ROOT_DOMAIN=toplinehub.co.ke
TOPLINE_TIMEZONE=Africa/Nairobi
# How long a login lasts, in hours
SESSION_HOURS=72

# Payments. "simulation" until you have Paystack keys: payments are approved on an on-screen
# test phone, so anyone could open a shop for free. Switch to "paystack" before going public.
PAYMENTS_MODE=simulation
SIMULATION_APPROVAL=prompt
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Your cut of online orders, in percent (0 = shops get everything)
PLATFORM_COMMISSION_PERCENT=0
# An M-PESA prompt nobody answers is cancelled after this many minutes (its stock goes back on sale)
PAYMENT_TIMEOUT_MINUTES=10

# Days a shop keeps selling after its plan payment is due, before it's suspended
GRACE_DAYS=7

# Photos: "disk" keeps them in storage/app/uploads (back that folder up); "database" keeps them in MySQL
UPLOAD_STORAGE=disk
MAX_UPLOAD_MB=5

# SMS (optional, Africa's Talking): order alerts to shops and customers, and problem alerts to you.
# Logins use passwords, so the site works without SMS.
SMS_MODE=simulation
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Alerts when something breaks (optional): a Slack / Discord / Teams incoming-webhook URL
ALERT_WEBHOOK_URL=
# and/or SMS to these numbers, comma-separated (needs SMS_MODE=africastalking)
ALERT_SMS_PHONES=

# Only needed if you can't use "php artisan schedule:run" in Cron Jobs: a long random text,
# then call https://toplinehub.co.ke/api/cron/run?key=THAT_TEXT every 5 minutes instead.
CRON_SECRET=
