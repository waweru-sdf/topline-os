# Production build settings (Hostinger builds the website with these).
# Now: website on Hostinger, backend on Render at api.toplinehub.co.ke, shop links as /s/<shop>.
# Later on a VPS, deploy/setup.sh overrides these in .env.production.local.
VITE_API_URL=https://api.toplinehub.co.ke/api
VITE_ROOT_DOMAIN=toplinehub.co.ke
VITE_STORE_LINKS=path
