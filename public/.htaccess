<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    # No automatic "folder/" redirects: they'd use http:// and expose /public. The rules below decide.
    DirectorySlash Off
    RewriteOptions AllowNoSlash

    # Redirects below are written out in full with https: Hostinger's server doesn't always know a
    # visit came over https, and a plain redirect would send browsers to http:// (Chrome then warns).
    # Local test servers (localhost) keep http.
    RewriteRule ^ - [E=TL_SCHEME:https]
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1|[a-z0-9-]+\.localhost)(:\d+)?$ [NC]
    RewriteRule ^ - [E=TL_SCHEME:http]

    # On Hostinger this folder sits inside public_html, so it can also be opened as /public/...
    # (old links, browser history). Send those to the real address: "/public/admin" → "/admin".
    # THE_REQUEST is what the browser asked for, so requests rewritten here internally never match.
    RewriteCond %{THE_REQUEST} \s/public/?[\s?]
    RewriteRule ^ %{ENV:TL_SCHEME}://%{HTTP_HOST}/ [L,R=301]
    RewriteCond %{THE_REQUEST} \s/public(/[^\s?]+)
    RewriteRule ^ %{ENV:TL_SCHEME}://%{HTTP_HOST}%1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %{ENV:TL_SCHEME}://%{HTTP_HOST}%1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Website files have content hashes in their names: cache them for a year. Pages are never cached.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Never serve hidden files such as .env if someone points the domain at the wrong folder.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
