# Live settings for the Topline API. setup.sh copies this to backend/.env and fills in
# the __PLACEHOLDERS__. Edit it later with:  sudo nano /opt/topline/app/backend/.env
# then:  sudo systemctl restart topline-api

APP_ENV=production
TRUST_PROXY=true
SECRET_KEY=__SECRET_KEY__
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES_HOURS=72

# PostgreSQL on this server, reached through its local socket (no password needed)
DATABASE_URL=postgresql+psycopg://topline@/topline?host=/var/run/postgresql

ROOT_DOMAIN=__DOMAIN__
FRONTEND_ORIGINS=https://__DOMAIN__
TIMEZONE=Africa/Nairobi
UPLOAD_FOLDER=/var/lib/topline/uploads

# --- Login codes (SMS) ---------------------------------------------------------
# "simulation": codes are NOT sent; they only appear in the server log:
#     sudo journalctl -u topline-api | grep "Topline code"
# Switch to Africa's Talking before shops start signing up:
SMS_MODE=simulation
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Never true on a live server (it shows login codes on the page). The server refuses to start if true.
EXPOSE_DEV_OTP=false

# --- Payments ----------------------------------------------------------------
# "simulation": no real money moves; an on-screen test phone approves payments.
# Go live: PAYMENTS_MODE=paystack + your live keys, and set the Paystack webhook to
#     https://__DOMAIN__/api/webhooks/paystack
PAYMENTS_MODE=simulation
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
SIMULATION_APPROVAL=prompt
SIMULATED_PAYMENT_DELAY_SECONDS=2
PAYMENT_TIMEOUT_MINUTES=10
PLATFORM_COMMISSION_PERCENT=0

GRACE_DAYS=7

# --- Alerts when something breaks ---------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_SMS_PHONES=
