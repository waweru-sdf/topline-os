# Copy to .env and adjust. Never commit .env.

# Long random strings in production (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=dev-only-insecure-key-change-me-before-going-live
JWT_SECRET=dev-only-insecure-key-change-me-before-going-live
JWT_EXPIRES_HOURS=72

# SQLite by default. Production: postgresql+psycopg://user:pass@host:5432/topline
# DATABASE_URL=

# Browser origins allowed to call the API (store subdomains are allowed automatically)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
ROOT_DOMAIN=toplinehub.co.ke
TIMEZONE=Africa/Nairobi

# Payments. "simulation" = no real money; an on-screen test phone approves/declines.
# To go live: set PAYMENTS_MODE=paystack and paste your keys (see README "Going live with Paystack").
PAYMENTS_MODE=simulation
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Simulation: "prompt" waits for the test phone, "auto" approves after the delay below
SIMULATION_APPROVAL=prompt
SIMULATED_PAYMENT_DELAY_SECONDS=2
# Minutes to wait for a customer to approve an M-PESA prompt before the order is released
PAYMENT_TIMEOUT_MINUTES=10
# Topline's cut from online orders before paying the shop (0 = shop gets everything)
PLATFORM_COMMISSION_PERCENT=0

# Development here; the live server uses deploy/env.production.example instead
APP_ENV=development

# SMS: "simulation" prints codes to the log and shows them on the login page.
# "africastalking" sends real SMS with the keys below (AT_USERNAME=sandbox to test).
SMS_MODE=simulation
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
EXPOSE_DEV_OTP=true

# Days a store stays open after a missed payment before it's suspended
GRACE_DAYS=7

# Photos uploaded by shops and admins (default: backend/instance/uploads)
# UPLOAD_FOLDER=
MAX_UPLOAD_MB=5

# Alerts when something breaks. A Slack / Discord / Teams incoming-webhook URL works now.
ALERT_WEBHOOK_URL=
# Comma-separated phones for SMS alerts (sent once SMS_MODE is live)
ALERT_SMS_PHONES=
